# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ── Virtual environments ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
.venv/
venv/
env/

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
frontend/tsconfig.tsbuildinfo
tsconfig.tsbuildinfo

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Claude Code ──────────────────────────────────────────────────────────────
.claude/

# ── DATASETS  (not committed — download from Google Drive) ──────────────────
# Link: https://drive.google.com/drive/folders/1agc1hXlVinXAPM-7E8RFfAFopKVrIota
# Unzip / copy all files into datasets/ before running any training script.
datasets/*
!datasets/.gitkeep

# ── V1 model artifacts (CatBoost) ────────────────────────────────────────────
# Generated by: cd training && python preprocess.py && python train.py
# model_metadata.json is small JSON and intentionally tracked.
backend/model/*.pkl
training/data/
training/output/
training/catboost_info/

# V1 raw Dryad source data (large; included in the Google Drive folder above)
training/microbiology_cultures_demographics.csv
training/microbiology_cultures_microbial_resistance.csv

# ── V2 ARMD model artifacts (RandomForest) ───────────────────────────────────
# Generated by: cd armd_model && python train_armd.py && python train_dosage.py
#                                && python build_antibiogram.py
armd_model/artifacts/*
!armd_model/artifacts/.gitkeep
# Track the small artifacts + compressed RF recommender + lookup + antibiogram so
# the Render Docker image has them. The large dose/route ML models (>100MB / not
# needed — dosage_service falls back to the lookup + static table) stay ignored.
!armd_model/artifacts/rf_top3_recommender_optimized.joblib
!armd_model/artifacts/feature_cols.joblib
!armd_model/artifacts/selected_antibiotics.joblib
!armd_model/artifacts/best_threshold.joblib
!armd_model/artifacts/feature_importances.joblib
!armd_model/artifacts/split_test_summary.joblib
!armd_model/artifacts/metadata_optimized.json
!armd_model/artifacts/organism_antibiotic_panel.json
!armd_model/artifacts/dose_route_lookup.csv

graphify-out
.graphify_python